# dependencies
/node_modules
/.tmp-node
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Superpowers brainstorm sessions
.superpowers/
# claude code (worktrees e config local de dev)
/.claude/

# Acervos de imagem brutos: os ZIPs do MTur passam de 1 GB e ficariam
# servidos publicamente pelo Next se entrassem em public/. Extraia,
# selecione pela curadoria (src/data/photoCuration.ts) e versione apenas
# os arquivos otimizados em public/images/destinations/.
/public/images/*.zip
/public/images/*.ZIP
